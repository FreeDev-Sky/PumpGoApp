{
  "name": "pumpgoapp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start:customer": "npm run start -w @pumpgoapp/customer",
    "start:station": "npm run start -w @pumpgoapp/station",
    "start:manager": "npm run start -w @pumpgoapp/manager",
    "android:customer": "npm run android -w @pumpgoapp/customer",
    "android:station": "npm run android -w @pumpgoapp/station",
    "android:manager": "npm run android -w @pumpgoapp/manager",
    "ios:customer": "npm run ios -w @pumpgoapp/customer",
    "ios:station": "npm run ios -w @pumpgoapp/station",
    "ios:manager": "npm run ios -w @pumpgoapp/manager",
    "web:customer": "npm run web -w @pumpgoapp/customer",
    "web:station": "npm run web -w @pumpgoapp/station",
    "web:manager": "npm run web -w @pumpgoapp/manager",
    "api:dev": "npm run dev -w @pumpgoapp/api",
    "api:build": "npm run build -w @pumpgoapp/api"
  }
}
